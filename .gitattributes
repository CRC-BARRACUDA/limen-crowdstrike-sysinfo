# Developed on both Windows and Linux with core.autocrlf=true, which rewrites
# checked-out text files with CRLF. That breaks anything the OS has to execute.
# Pin line endings per file type instead of leaving it to the platform.

* text=auto

# The RTR scripts are built as Python string literals inside main.py and sent
# over the API, so they never touch the disk — but main.py itself is run by the
# host's interpreter, and a Python file is fine either way.
*.sh   text eol=lf
*.ps1  text eol=crlf
